#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Description of the plugin
#: openporte.php
msgid ""
"Stop spam without CAPTCHAs. Proof-of-Work protection for your site. Open-"
"source, self-hosted, privacy-first."
msgstr ""
"Stoppt Spam ohne CAPTCHAs. Proof-of-Work-Schutz. Open-Source, "
"selbstgehostet, datenschutzfreundlich."

#. Author of the plugin
#: openporte.php
msgid "OpenPorte Contributors"
msgstr "OpenPorte-Mitwirkende"

