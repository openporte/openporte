"eququzelelweyo."

#: admin/options.php:198
msgid ""
"Choose what happens to the OpenPorte settings when the plugin is deleted."
msgstr "Khetha okwenzekayo kwizicwangciso ze-OpenPorte xa i-plugin icinywa."

#. translators: %1$s and %2$s are opening and closing tags for bold
#: admin/options.php:202
