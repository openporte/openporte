#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Description of the plugin
#: openporte.php
msgid ""
"Stop spam without CAPTCHAs. Proof-of-Work protection for your site. Open-"
"source, self-hosted, privacy-first."
msgstr ""
"CAPTCHA olmadan spam'ı durdurun. Proof-of-Work ile sitenizi koruyun. Açık "
"kaynak, kendi sunucunuzda, gizlilik odaklı."

#. Author of the plugin
