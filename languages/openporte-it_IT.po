#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Plugin URI of the plugin
#: openporte.php
msgid "https://github.com/openporte/openporte"
msgstr "https://github.com/openporte/openporte"

#. Description of the plugin
#: openporte.php
msgid ""
"Stop spam without CAPTCHAs: a Proof-of-Work anti-spam check for your forms "
"and logins. Open-source, self-hosted, privacy-first."
msgstr "Fermi lo spam senza CAPTCHAs: un controllo anti-spam Proof-of-Work per moduli e accessi. Open-source, auto-ospitato, privacy-first."

