#: includes/core.php:474 integrations/enfold-theme.php:58
msgid "Verification failed. Try again later."
msgstr "検証に失敗しました。後でもう一度試してください。"

#. translators: %1$s and %2$s are the opening and closing tags for a link (<a> tag)
#: includes/core.php:477
#, php-format
